# Single-process probe: raw AF_PACKET sender + OpenCV camera in one container.
# Run with:  docker run --rm --net=host --privileged --device=/dev/video0 \
#              -v "$PWD":/app -w /app panelprobe python tools/panelprobe.py ...
FROM python:3.12-slim
RUN pip install --no-cache-dir numpy opencv-python-headless
